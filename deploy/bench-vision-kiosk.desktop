[Desktop Entry]
Type=Application
Name=bench-vision wall display
Comment=Open the bench-vision display page fullscreen once its server answers
Exec=sh -c "until wget -q -O /dev/null http://127.0.0.1:8765/state; do sleep 1; done; exec chromium --kiosk --noerrdialogs --disable-infobars --no-first-run --password-store=basic http://127.0.0.1:8765"
X-GNOME-Autostart-enabled=true
